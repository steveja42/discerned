{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // "chrome": several specs call chrome.* inside page.evaluate() — that code
    // runs in the extension's context, so the types are real, not a shim.
    // Resolved from discerned-ext's @types via typeRoots below.
    "types": ["node", "chrome"],
    "typeRoots": ["../discerned-ext/node_modules/@types", "../node_modules/@types"]
  },
  "include": ["./**/*"]
}
