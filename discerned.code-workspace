{
  "folders": [
    { "path": "discerned-ext", "name": "🧩 Extension" },
    { "path": "discerned-web", "name": "🌐 Web app" },
    { "path": "tests",         "name": "🧪 E2E tests" },
    { "path": ".",             "name": "📁 Monorepo root" }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": false,
      "**/dist-test": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/dist-test": true,
      "**/test-results": true,
      "**/discerned-web - Copy": true,
      "**/discernedx": true,
      "**/legacy": true,
      "**/marketing": true
    },
    "js/ts.tsdk.path": "discerned-web/node_modules/typescript/lib",
    "eslint.workingDirectories": [
      { "directory": "discerned-ext", "changeProcessCWD": true },
      { "directory": "discerned-web", "changeProcessCWD": true }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "compounds": [
      {
        "name": "🚀 Debug everything (Brave + extension + web)",
        "configurations": [
          "Debug: Brave (main-default)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": {
          "hidden": false,
          "group": "1_compounds",
          "order": 1
        }
      }
    ]
  }
}
