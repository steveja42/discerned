{
  "folders": [
    { "path": "discerned-ext", "name": "🧩 Extension" },
    { "path": "discerned-web", "name": "🌐 Web app" },
    { "path": "tests",         "name": "🧪 E2E tests" },
    { "path": ".",             "name": "📁 Monorepo root" }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": false,
      "**/dist-test": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true,
      "**/dist-test": true,
      "**/test-results": true,
      "**/discerned-web - Copy": true,
      "**/discernedx": true,
      "**/legacy": true,
      "**/marketing": true
    },
    "js/ts.tsdk.path": "discerned-web/node_modules/typescript/lib",
    "eslint.workingDirectories": [
      { "directory": "discerned-ext", "changeProcessCWD": true },
      { "directory": "discerned-web", "changeProcessCWD": true }
    ],
    // Lint TS/TSX explicitly — without this the extension is inconsistent about
    // reporting them in a multi-root workspace.
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    // onSave, NOT onType: eslint-config-next runs type-aware rules plus the
    // React Compiler analysis, which measures ~5-6s for a single .tsx here
    // (see the 6107ms warning in the ESLint output log). Linting on every
    // keystroke queues those runs faster than they finish, which is why the
    // Problems panel appeared empty — results arrived stale or not at all.
    "eslint.run": "onSave",
    "eslint.quiet": false
  },
  "launch": {
    "version": "0.2.0",
    "compounds": [
      {
        "name": "🚀 Debug both (Brave main-default + web)",
        "configurations": [
          "Debug: Brave (main-default)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 1 }
      },
      {
        "name": "🚀 Debug both (Brave no nsec + web)",
        "configurations": [
          "Debug: Brave (no nsec)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 2 }
      },
      {
        "name": "🚀 Debug both (Brave nip07-nos2x + web)",
        "configurations": [
          "Debug: Brave (nip07-nos2x)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 3 }
      },
      {
        "name": "🚀 Debug both (Brave nip07-alby + web)",
        "configurations": [
          "Debug: Brave (nip07-alby)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 4 }
      },
      {
        "name": "🚀 Debug both (Brave stored key + web)",
        "configurations": [
          "Debug: Brave (stored key)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 5 }
      },
      {
        "name": "🚀 Debug both (Chrome Isolated + web)",
        "configurations": [
          "Debug: Chrome (Isolated)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 6 }
      },
      {
        "name": "🚀 Debug both (Chrome nos2x + web)",
        "configurations": [
          "Debug: Chrome (nos2x)",
          "Attach to Chrome (shared with extension debugger)"
        ],
        "stopAll": true,
        "presentation": { "hidden": false, "group": "1_compounds", "order": 7 }
      }
    ]
  }
}
