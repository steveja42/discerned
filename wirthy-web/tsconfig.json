{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // netlify/functions has its own tsconfig — those files are ESM bundled by esbuild at
  // deploy time (not by Next) and need allowImportingTsExtensions, which must not leak
  // into the app. `pnpm type-check` checks both.
  //
  // The function's test is excluded here for the same reason: it imports the .mts handler
  // directly, so it needs the same extension allowance. Vitest resolves it fine at runtime,
  // and tsconfig.test.json type-checks it.
  "exclude": ["node_modules", "netlify/functions", "tests/feedback-function.test.ts"]
}
