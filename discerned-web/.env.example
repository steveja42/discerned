# Point the public feed at a local Nostr relay for dev/test (replaces the real
# wss:// relays). Leave unset/empty in production. See tools/nostr-relay/.
NEXT_PUBLIC_LOCAL_RELAY=

# Cloudflare Turnstile site key for the /feedback form. PUBLIC by design — it ships to
# the browser. The SECRET half (TURNSTILE_SECRET_KEY) is set only in the Netlify dashboard
# and never lives in this repo. Unset here falls back to Cloudflare's documented
# always-passes TEST key, so the form works in local dev without any setup.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Netlify Functions don't run under `next dev`, so /api/feedback 404s locally. To exercise
# the real function, run it standalone and point the client at it:
#   pnpm exec netlify functions:serve --port 9999
#   NEXT_PUBLIC_FUNCTIONS_ORIGIN=http://localhost:9999/.netlify/functions
# Leave unset in production (the function is served same-origin at /api/feedback).
# NOTE: `next dev` must be RESTARTED to pick up a change to this file.
NEXT_PUBLIC_FUNCTIONS_ORIGIN=

# Analytics: nothing to set here. The GoatCounter site code (discernedweb) is a
# literal in netlify.toml as the /api/stats/* reverse-proxy target — NOT a client
# env var. The browser only ever talks to same-origin /api/stats/* (count.js is
# vendored at public/api/stats/count.js). Analytics is gated to hostname
# discerned.online, so it's a no-op on localhost and Netlify deploy previews.
