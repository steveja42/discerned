# Point the public feed at a local Nostr relay for dev/test (replaces the real
# wss:// relays). Leave unset/empty in production. See tools/nostr-relay/.
NEXT_PUBLIC_LOCAL_RELAY=

# Analytics: nothing to set here. The GoatCounter site code (discernedweb) is a
# literal in netlify.toml as the /api/stats/* reverse-proxy target — NOT a client
# env var. The browser only ever talks to same-origin /api/stats/* (count.js is
# vendored at public/api/stats/count.js). Analytics is gated to hostname
# discerned.online, so it's a no-op on localhost and Netlify deploy previews.
