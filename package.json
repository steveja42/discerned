{
  "name": "discerned",
  "version": "0.1.0",
  "description": "Value Attribution Layer for the Web",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-crxjs.mjs",
    "dev": "vite dev",
    "watch": "vite build --watch",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "nostr-tools": "^2.7.2",
    "terser": "^5.46.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-plugin-static-copy": "^1.0.1",
    "vitest": "^1.2.2",
    "@vitest/coverage-v8": "^1.2.2",
    "jsdom": "^24.0.0",
    "@types/jsdom": "^21.1.6",
    "fast-glob": "^3.3.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
