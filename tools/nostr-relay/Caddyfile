# TLS terminator for the local Nostr relay.
#
# Browser Nostr clients served over https:// (nostrudel.ninja, coracle.social)
# cannot open an insecure ws:// socket — the browser blocks mixed content. This
# fronts the loopback relay (ws://127.0.0.1:7777) with wss://localhost:7778 using
# an mkcert-issued cert (trusted by your OS/browser store). Point web clients at
#   wss://localhost:7778
# and they'll read/publish the same events as ws://localhost:7777.
#
# Run: pnpm relay:tls  (from repo root) — see run-tls.ps1 / README.
{
	# No automatic HTTPS provisioning — we supply an mkcert cert below; Caddy must
	# not try to fetch a public one. (Admin API left on so `caddy stop` works.)
	auto_https off
}

localhost:7778 {
	# mkcert-issued cert (generated by run-tls.ps1 / README instructions).
	tls certs/localhost.pem certs/localhost-key.pem

	# nostr-rs-relay speaks plain WebSocket on 7777. reverse_proxy upgrades and
	# forwards the WS connection transparently.
	reverse_proxy 127.0.0.1:7777
}
