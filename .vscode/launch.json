 {
  "version": "0.2.0",
  "configurations": [
{
  "name": "Debug: Chrome (Isolated)",
  "type": "chrome",
  "request": "launch",
  "url": "https://example.com/",
  "webRoot": "${workspaceFolder}",
  "userDataDir": "${workspaceFolder}/.vscode/profiles/chrome_iso",
  "runtimeArgs": [
    "--load-extension=${workspaceFolder}/dist",
    "--no-first-run",
    "--no-default-browser-check",
    "--remote-debugging-port=9222"
  ],
  "skipFiles": ["<node_internals>/**/*.js"]
},
{
  "name": "Debug: Chrome (nos2x)",
  "type": "chrome",
  "request": "launch",
  "url": "https://example.com/",
  "webRoot": "${workspaceFolder}",
  "userDataDir": "${workspaceFolder}/.vscode/profiles/chrome",
  "runtimeArgs": [
    "--load-extension=${workspaceFolder}/dist",
    "--no-first-run",
    "--no-default-browser-check",
    "--remote-debugging-port=9222"
  ],
  "skipFiles": ["<node_internals>/**/*.js"]
},
    {
      "name": "Debug: Brave (no nsec)",
      "type": "chrome",
      "request": "launch",
      "url": "https://example.com/",
      "webRoot": "${workspaceFolder}",
      /* --- Path for Windows --- */
      "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
      /* --- Path for macOS (Uncomment if needed) --- */
      // "runtimeExecutable": "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
      "userDataDir": "${workspaceFolder}/.vscode/profiles/brave",
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}\\dist",
        "--no-first-run"
      ]
    },
